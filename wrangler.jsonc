{
  "main": ".open-next/worker.js",
  "name": "tursostudio",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Markefin account: KV namespace "tursostudio-next-cache" for the Next.js incremental cache
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "ecfb3d796d824dc681886dd76406c523"
    }
  ],
  // Served only on the custom domain (Cloudflare creates the DNS record and certificate);
  // the workers.dev URL is off so Cloudflare Access on the domain cannot be bypassed.
  "routes": [{ "pattern": "tursostudio.markefin.app", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
